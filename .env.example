# Every environment variable the code reads. No values belong in this file.
#
# There are two places these go:
#   - Python event pipeline: copy this file to .env in the repository root (ignored by Git).
#   - Hosted product (web/): set them in the Vercel project, or in web/.env.local for `vercel dev`.

# ---------------------------------------------------------------------------
# Python event pipeline (src/ghostleads, app/dashboard.py)  ->  ./.env
# ---------------------------------------------------------------------------

# Draft stage, attendee search, reply handling, scraper LLM fallback
OPENAI_API_KEY=
# Optional: model for the scraper's LLM fallback (default gpt-4.1-mini)
OPENAI_MODEL=
# Dedupe stage: is the company already in AI Ark
AIARK_API_KEY=
# Enrich and verify stages
BLITZ_API_KEY=
# Attendee search, reviewed drafts, send and reply sync
NEEDLE_API_KEY=
# Optional: lets the scraper look up a website for exhibitors that list none
SERPER_API_KEY=
# Alternative search provider with a monthly free allowance; used when SERPER_API_KEY is empty
BRAVE_API_KEY=
# Optional: SQLite database path (default data/ghostleads.db)
GL_DB=

# Cloud bridge only (python -m ghostleads.cloud publish | worker)
# Supabase project URL and publishable (anon) key
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Shared secret the worker presents to the gl_worker_* RPCs; Supabase stores only its hash
GL_WORKER_SECRET=

# ---------------------------------------------------------------------------
# Vercel functions (web/api, web/server)  ->  Vercel project env, or web/.env.local
# ---------------------------------------------------------------------------

# Optional: enables /api/draft, AI extraction with custom columns, AI fallback for directory pages
# OPENAI_API_KEY=
# Optional: model for the above (default gpt-4.1-mini)
# OPENAI_MODEL=
# Optional: web search through Serper; without it DuckDuckGo is tried and usually refuses
# SERPER_API_KEY=
# Optional: Overpass API endpoint for the local-business source (default: Nominatim tag search)
# OVERPASS_URL=
# Only for your own Supabase project: where the functions call the gl_use RPC.
# Defaults to the hosted project; set together with the VITE_ pair below.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Set by Vercel; shown as the version in /api/health
# VERCEL_GIT_COMMIT_SHA=

# ---------------------------------------------------------------------------
# Browser bundle (web/src), read by Vite at build time  ->  Vercel project env, or web/.env.local
# These are public: never put a secret in a VITE_ variable.
# ---------------------------------------------------------------------------

# Only for your own Supabase project: project URL and publishable (anon) key for the browser client
# VITE_SUPABASE_URL=
# VITE_SUPABASE_KEY=
